<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Primary Palette (Potta Brand) -->
    <Color x:Key="PrimaryColor">#1B5E20</Color>
    <Color x:Key="PrimaryLightColor">#2E7D32</Color>
    <Color x:Key="PrimaryDarkColor">#0D3B11</Color>
    <Color x:Key="AccentColor">#4CAF50</Color>
    <Color x:Key="AccentLightColor">#81C784</Color>
    
    <!-- Neutral & Surface Colors -->
    <Color x:Key="TextPrimaryColor">#1F2937</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="TextMutedColor">#9CA3AF</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="BorderLightColor">#F3F4F6</Color>
    <Color x:Key="BackgroundColor">#F5F5F5</Color>
    <Color x:Key="SurfaceBackgroundColor">#F9FAFB</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="HoverSurfaceColor">#F3F4F6</Color>
    <Color x:Key="PressedSurfaceColor">#E5E7EB</Color>
    
    <!-- Status & Alerts -->
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DangerSurfaceColor">#FEF2F2</Color>
    <Color x:Key="RefireBorderColor">#FF6B6B</Color>
    <Color x:Key="RefireSurfaceColor">#FFF5F5</Color>
    <Color x:Key="WarningColor">#FFA500</Color>
    <Color x:Key="WarningSurfaceColor">#FFFBEB</Color>
    <Color x:Key="SuccessColor">#1B5E20</Color>
    <Color x:Key="SuccessSurfaceColor">#F0FDF4</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}"/>
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="{StaticResource PressedSurfaceColor}"/>
    
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}"/>
    <SolidColorBrush x:Key="RefireBorderBrush" Color="{StaticResource RefireBorderColor}"/>
    <SolidColorBrush x:Key="RefireSurfaceBrush" Color="{StaticResource RefireSurfaceColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
</ResourceDictionary>
