<UserControl x:Class="PottaKDS.Components.CustomMessageBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ColorsAndBrushes.xaml"/>
                <ResourceDictionary Source="/Resources/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="DialogContainer"
                Width="480" 
                MinHeight="180"
                MaxHeight="400"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderThickness="1"
                BorderBrush="#E0E0E0"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" x:Name="HeaderBorder" Background="#F8FAFC" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB" CornerRadius="8,8,0,0">
                    <Grid Height="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon: vector disc + symbol -->
                        <Viewbox Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center" Margin="20,0,12,0">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="IconCircle" StrokeThickness="0" Fill="#1E40AF"/>
                                <Path x:Name="IconSymbol" Fill="Transparent" Stroke="White" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Title -->
                        <TextBlock x:Name="TitleTextBlock" Grid.Column="1" Text="Confirmation" 
                                   FontSize="16" FontWeight="SemiBold"
                                   FontFamily="{StaticResource OutfitBold}" VerticalAlignment="Center"/>

                        <!-- Close Button -->
                        <Button x:Name="CloseButton" Grid.Column="2" Content="✕" 
                                FontSize="14" FontFamily="{StaticResource OutfitMedium}"
                                Background="Transparent" BorderThickness="0"
                                Width="44" Height="44" Click="CloseButton_Click" Cursor="Hand" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,18">
                    <TextBlock x:Name="MessageTextBlock"
                               Text="Are you sure you want to proceed?" 
                               FontSize="14" FontFamily="{StaticResource OutfitRegular}"
                               Foreground="#374151" TextWrapping="Wrap" LineHeight="22"/>
                </ScrollViewer>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" CornerRadius="0,0,8,8">
                    <Grid Margin="20,14" x:Name="ButtonPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel"
                                Style="{StaticResource NeutralButtonStyle}"
                                Width="110" Height="38" Margin="0,0,10,0" Click="CancelButton_Click"/>

                        <Button x:Name="ConfirmButton" Grid.Column="2" Content="Confirm"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="110" Height="38" Click="ConfirmButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
