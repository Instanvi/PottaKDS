<Window x:Class="PottaKDS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:PottaKDS.Views.Components"
        mc:Ignorable="d"
        Title="Potta KDS - Kitchen Display System" 
        Height="800" Width="1280"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/pottaLogo.ico"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Components/ColorsAndBrushes.xaml"/>
                <ResourceDictionary Source="/Components/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Components/ComboBoxStyles.xaml"/>
                <ResourceDictionary Source="/Components/TextBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header Bar -->
            <RowDefinition Height="Auto"/> <!-- Offline / Error Banner -->
            <RowDefinition Height="*"/>    <!-- Masonry Cards Area -->
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Brand & Logo -->
                    <ColumnDefinition Width="*"/>    <!-- Filter Tabs & Counters -->
                    <ColumnDefinition Width="Auto"/> <!-- Controls -->
                </Grid.ColumnDefinitions>

                <!-- Brand Section with Official Potta Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Image Source="pack://application:,,,/PottaKDS;component/Resources/pottaLogo.png" 
                           Width="36" Height="36" 
                           RenderOptions.BitmapScalingMode="HighQuality" 
                           Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Potta" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource OutfitBold}" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text=" KDS" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource OutfitBold}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <!-- Connection Status Indicator -->
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatusText}" 
                                       FontSize="11" FontFamily="{StaticResource OutfitMedium}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Foreground" Value="#059669"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Filter Tabs & Counts -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- All Tab -->
                    <RadioButton GroupName="StatusFilter" Content="All" Margin="0,0,8,0"
                                 IsChecked="{Binding IsFilterAll, Mode=TwoWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="All">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="bd" CornerRadius="6" Padding="14,8" Background="Transparent" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="All Orders" FontSize="13" FontFamily="{StaticResource OutfitSemiBold}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#E5E7EB" CornerRadius="10" MinWidth="20" Height="20" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalOrdersCount}" FontSize="11" FontFamily="{StaticResource OutfitSemiBold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- Pending Tab -->
                    <RadioButton GroupName="StatusFilter" Content="Pending" Margin="0,0,8,0"
                                 IsChecked="{Binding IsFilterPending, Mode=TwoWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Pending">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="bd" CornerRadius="6" Padding="14,8" Background="Transparent" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pending" FontSize="13" FontFamily="{StaticResource OutfitSemiBold}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#FEF3C7" CornerRadius="10" MinWidth="20" Height="20" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PendingOrdersCount}" FontFamily="{StaticResource OutfitSemiBold}" FontSize="11" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FEF3C7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- Delayed Tab -->
                    <RadioButton GroupName="StatusFilter" Content="Delayed" Margin="0,0,8,0"
                                 IsChecked="{Binding IsFilterDelayed, Mode=TwoWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Delayed">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="bd" CornerRadius="6" Padding="14,8" Background="Transparent" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource DangerBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Delayed" FontSize="13" FontFamily="{StaticResource OutfitSemiBold}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#FEE2E2" CornerRadius="10" MinWidth="20" Height="20" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DelayedOrdersCount}" FontFamily="{StaticResource OutfitSemiBold}" FontSize="11" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- Ready Tab -->
                    <RadioButton GroupName="StatusFilter" Content="Ready"
                                 IsChecked="{Binding IsFilterReady, Mode=TwoWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Ready">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="bd" CornerRadius="6" Padding="14,8" Background="Transparent" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ready" FontSize="13" FontFamily="{StaticResource OutfitSemiBold}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#DCFCE7" CornerRadius="10" MinWidth="20" Height="20" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ReadyOrdersCount}" FontFamily="{StaticResource OutfitSemiBold}" FontSize="11" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#DCFCE7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>

                <!-- Action Controls Section -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Audio Alert Toggle with Vector Icon -->
                    <Button Style="{StaticResource IconActionButtonStyle}" 
                            Command="{Binding ToggleAudioCommand}"
                            ToolTip="Toggle Kitchen Audio Chimes" Margin="0,0,4,0">
                        <Path Stretch="Uniform" Width="18" Height="18" Fill="{StaticResource TextSecondaryBrush}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconVolumeHighGeometry}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AudioAlertsEnabled}" Value="False">
                                            <Setter Property="Data" Value="{StaticResource IconVolumeMuteGeometry}"/>
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- Fullscreen Toggle (F11) with Vector Icon -->
                    <Button Style="{StaticResource IconActionButtonStyle}" 
                            Command="{Binding ToggleFullscreenCommand}"
                            ToolTip="Toggle Fullscreen (F11)" Margin="0,0,4,0">
                        <Path Stretch="Uniform" Width="16" Height="16" Fill="{StaticResource TextSecondaryBrush}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconFullscreenGeometry}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconFullscreenExitGeometry}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- Settings Button with Vector Gear -->
                    <Button Style="{StaticResource IconActionButtonStyle}" 
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Server Connection Settings" Margin="0,0,8,0">
                        <Path Data="{StaticResource IconSettingsGeometry}" Stretch="Uniform" Width="17" Height="17" Fill="{StaticResource TextSecondaryBrush}"/>
                    </Button>

                    <!-- Refresh Button with Vector Icon -->
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding RefreshCommand}"
                            Height="38" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefreshGeometry}" Stretch="Uniform" Width="13" Height="13" Fill="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" FontSize="13" FontFamily="{StaticResource OutfitSemiBold}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Reconnection / Offline Banner with Vector Warning -->
        <Border Grid.Row="1" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="0,0,0,1" Padding="16,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconWarningGeometry}" Fill="#DC2626" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Cannot connect to Potta POS server at " FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource OutfitSemiBold}" Foreground="#991B1B"/>
                    <TextBlock Text="{Binding ServerUrlDisplay}" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource OutfitBold}" Foreground="#991B1B"/>
                    <TextBlock Text=" - Automatically retrying..." FontSize="12" FontFamily="{StaticResource OutfitRegular}" Foreground="#991B1B"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Change IP / Settings" Style="{StaticResource CancelButtonStyle}" Height="30" Padding="10,4" FontSize="12"
                            Command="{Binding OpenSettingsCommand}" Margin="0,0,6,0"/>
                    <Button Content="Retry Now" Style="{StaticResource PrimaryButtonStyle}" Height="30" Padding="10,4" FontSize="12"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main Display Area (Masonry Multi-Column Layout) -->
        <ScrollViewer x:Name="MasonryScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="MasonryContainer" Margin="14,14,14,24">
                <!-- Columns dynamically generated in code-behind based on screen width -->
            </Grid>
        </ScrollViewer>

        <!-- Hidden ItemsControl for DataTemplate reference -->
        <ItemsControl x:Name="HiddenTemplateHolder" Grid.Row="2" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <components:KitchenOrderCard Margin="6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty State (When no waiting orders) with Vector Plate & Cutlery Graphic -->
        <Grid Grid.Row="2" Background="Transparent">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNoOrders}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#E8F5E9" Width="88" Height="88" CornerRadius="44" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconPlateGeometry}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No Pending Orders" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource OutfitBold}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="The kitchen is all caught up! New orders will automatically appear here." FontSize="14" FontFamily="{StaticResource OutfitRegular}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                <Button Content="Refresh Queue" Style="{StaticResource NuetralCancelButtonStyle}" Margin="0,18,0,0" HorizontalAlignment="Center"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
