<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>PottaKDS</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\pottaLogo.ico</ApplicationIcon>
    <!-- Stamped by BUILD-INSTALLER.bat via -p:APP_VERSION=... -->
    <APP_VERSION Condition="'$(APP_VERSION)'==''">1.3.6.2</APP_VERSION>
    <Version>$(APP_VERSION)</Version>
    <AssemblyVersion>$(APP_VERSION)</AssemblyVersion>
    <FileVersion>$(APP_VERSION)</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\Outfit-*.ttf" />
    <Resource Include="Resources\*.png" />
    <Resource Include="Resources\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

</Project>
