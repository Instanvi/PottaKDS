<Window x:Class="PottaKDS.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        Title="Potta KDS - Connection Settings" 
        Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Components/ColorsAndBrushes.xaml"/>
                <ResourceDictionary Source="/Components/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Components/ComboBoxStyles.xaml"/>
                <ResourceDictionary Source="/Components/TextBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Settings Body -->
            <RowDefinition Height="Auto"/> <!-- Actions Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header with Vector Gear -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSettingsGeometry}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="KDS Connection &amp; Settings" 
                           FontSize="18" FontWeight="SemiBold"
                           FontFamily="{StaticResource OutfitBold}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Configure connection to Potta POS Server on your Local Network (LAN)" 
                       FontSize="12" FontFamily="{StaticResource OutfitRegular}"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="26,4,0,0"/>
        </StackPanel>

        <!-- 2. Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Server Connection Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="POS SERVER CONNECTION" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource OutfitBold}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                        <!-- Server IP -->
                        <TextBlock Text="Server IP / Hostname" FontSize="13" FontWeight="Medium" FontFamily="{StaticResource OutfitMedium}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Grid Margin="0,4,0,12">
                            <TextBox Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource TextBoxStyle}"/>
                        </Grid>

                        <!-- Server Port -->
                        <TextBlock Text="API Port" FontSize="13" FontWeight="Medium" FontFamily="{StaticResource OutfitMedium}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource TextBoxStyle}"
                                 Margin="0,4,0,12"/>

                        <!-- Test & Scan Buttons -->
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource NuetralCancelButtonStyle}"
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconCheckGeometry}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Test Connection" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ScanNetworkCommand}"
                                    Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconSearchGeometry}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Auto-Scan LAN" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Test Feedback Message -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,6,0,0"
                                Visibility="{Binding TestStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTestSuccess}" Value="True">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTestSuccess}" Value="False">
                                            <Setter Property="Background" Value="#FEE2E2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TestStatusMessage}" 
                                       FontSize="12" FontFamily="{StaticResource OutfitMedium}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTestSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="#15803D"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTestSuccess}" Value="False">
                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Discovered Servers List with Vector Server Icon -->
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding DiscoveredServers.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Discovered Servers:" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource OutfitSemiBold}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding DiscoveredServers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NuetralCancelButtonStyle}" Height="36" Margin="0,2"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.SelectServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconServerGeometry}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ServerName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text=" - " VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding BaseUrl}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Display & Alert Preferences Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="KDS PREFERENCES" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource OutfitBold}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                        <!-- Auto-Refresh Interval -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Auto-Refresh Interval" FontSize="13" FontWeight="Medium" FontFamily="{StaticResource OutfitMedium}"/>
                                <TextBlock Text="How often orders refresh from server" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding PollIntervalSeconds}">
                                <ComboBoxItem Content="3 seconds" Tag="3"/>
                                <ComboBoxItem Content="5 seconds" Tag="5"/>
                                <ComboBoxItem Content="10 seconds" Tag="10"/>
                                <ComboBoxItem Content="15 seconds" Tag="15"/>
                                <ComboBoxItem Content="30 seconds" Tag="30"/>
                            </ComboBox>
                        </Grid>

                        <!-- Audio Alerts -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Audio Chimes" FontSize="13" FontWeight="Medium" FontFamily="{StaticResource OutfitMedium}"/>
                                <TextBlock Text="Play sound when new orders or refires arrive" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ModernToggleButtonStyle}" IsChecked="{Binding AudioAlertsEnabled}"/>
                        </Grid>

                        <!-- Fullscreen on Startup -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start in Fullscreen" FontSize="13" FontWeight="Medium" FontFamily="{StaticResource OutfitMedium}"/>
                                <TextBlock Text="Optimized for dedicated kitchen monitors" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ModernToggleButtonStyle}"  IsChecked="{Binding FullscreenOnStartup}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Actions Footer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Cancel" 
                    Style="{StaticResource NuetralCancelButtonStyle}" 
                    Margin="0,0,6,0"
                    Click="CancelButton_Click"/>

            <Button Grid.Column="1" Content="Save &amp; Connect" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Margin="6,0,0,0"
                    Command="{Binding SaveSettingsCommand}"/>
        </Grid>
    </Grid>
</Window>
